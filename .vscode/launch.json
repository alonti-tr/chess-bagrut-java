{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Chess: Run Server",
            "request": "launch",
            "mainClass": "chess.Main",
            "projectName": "chess-bagrut",
            "cwd": "${workspaceFolder}",
            "args": "server"
        },
        {
            "type": "java",
            "name": "Chess: Run Client",
            "request": "launch",
            "mainClass": "chess.Main",
            "projectName": "chess-bagrut",
            "cwd": "${workspaceFolder}",
            "args": "client"
        }
    ],
    "compounds": [
        {
            "name": "Chess: Server + Client",
            "configurations": ["Chess: Run Server", "Chess: Run Client"],
            "stopAll": true
        }
    ]
}
